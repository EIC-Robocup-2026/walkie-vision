<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>walkie_vision_msgs</name>
  <version>0.1.0</version>
  <description>
    Messages and services of Walkie's vision: object and person detections
    with their embeddings, text embeddings for searching them, and one
    person's crop on request.
  </description>
  <maintainer email="robloxplay41@gmail.com">natapol2547</maintainer>
  <!-- The repository's licence, as an SPDX identifier. The text is in LICENSE at the repository root. -->
  <license>AGPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
